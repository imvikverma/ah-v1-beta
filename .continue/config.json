    {
      "name": "backup-check",
      "prompt": "Check backups in _local/backups/ and scripts/backup_project.ps1"
    },
    {
      "name": "broker-integration",
      "prompt": "Broker API: Check api/ folder and _local/documentation/BROKER_API_INTEGRATION_GUIDE.md"
    }
  ],
  "tabAutocompleteModel": {
    "title": "TinyLlama (Fast)",
    "provider": "ollama",
    "model": "tinyllama",
    "apiBase": "http://localhost:11434",
    "contextLength": 512,
    "requestOptions": {
      "temperature": 0.3,
