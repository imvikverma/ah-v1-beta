      "provider": "ollama",
      "model": "phi3:mini",
      "apiBase": "http://localhost:11434",
      "contextLength": 2048,
      "requestOptions": {
        "temperature": 0.7,
        "maxTokens": 512,
        "topP": 0.9
      }
    },
    {
      "title": "TinyLlama (Fastest)",
      "provider": "ollama",
      "model": "tinyllama",
      "apiBase": "http://localhost:11434",
