# AurumHarmony Environment Variables
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=postgresql://aurum_user:aurum_password_change_in_production@postgres:5432/aurumharmony
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aurumharmony
POSTGRES_USER=aurum_user
POSTGRES_PASSWORD=aurum_password_change_in_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate-with-python-secrets-token-hex-32

# JWT
JWT_SECRET_KEY=generate-with-python-secrets-token-hex-32
JWT_ACCESS_TOKEN_EXPIRES=3600

# Broker API Keys
HDFC_API_KEY=your_hdfc_api_key
HDFC_API_SECRET=your_hdfc_api_secret
KOTAK_API_KEY=your_kotak_api_key
KOTAK_API_SECRET=your_kotak_api_secret
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret

# Encryption
ENCRYPTION_KEY=generate-with-fernet-generate-key

# Application Settings
LOG_LEVEL=INFO
MAX_WORKERS=4
