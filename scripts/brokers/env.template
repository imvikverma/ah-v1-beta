# AurumHarmony Broker Integration Configuration
# Copy this file to .env in the project root and fill in your credentials
# DO NOT commit .env to git (it's in .gitignore)

# ============================================
# HDFC Sky API Configuration
# ============================================
# Get these from: https://developer.hdfcsky.com
HDFC_SKY_API_KEY=your_api_key_here
HDFC_SKY_API_SECRET=your_api_secret_here

# Token ID from URL after web login (optional, but recommended)
# Format: Extract from URL parameter after logging into HDFC Sky web portal
HDFC_SKY_TOKEN_ID=your_token_id_here

# Access Token from OAuth flow (optional, alternative to token_id)
# Get this by completing OAuth flow or from browser localStorage after web login
HDFC_SKY_ACCESS_TOKEN=your_access_token_here

# Device ID (optional, has default)
HDFC_SKY_DEVICE_ID=88c1aec39d454d7ca740160f461e4285

# ============================================
# Kotak Neo API Configuration
# ============================================
# Get Access Token from: Kotak Neo App → Invest → Trade API
KOTAK_NEO_ACCESS_TOKEN=your_access_token_here

# Mobile number in format: +91XXXXXXXXXX (no spaces, no dashes)
# Example: +919876543210
KOTAK_NEO_MOBILE_NUMBER=+91XXXXXXXXXX

# Client Code (UCC) - Found in Kotak Neo app or account statements
KOTAK_NEO_CLIENT_CODE=your_client_code_here

# Session tokens (optional, set automatically after login)
# These are valid for 24 hours after login
# KOTAK_NEO_VIEW_TOKEN=your_view_token_here
# KOTAK_NEO_VIEW_SID=your_view_sid_here
# KOTAK_NEO_TRADE_TOKEN=your_trade_token_here
# KOTAK_NEO_TRADE_SID=your_trade_sid_here
# KOTAK_NEO_BASE_URL=your_base_url_here

# ============================================
# Trading Mode Configuration
# ============================================
# Set to PAPER for paper trading, LIVE for real trading
AURUM_TRADING_MODE=PAPER

# Use live data for paper trading (requires Kotak Neo or HDFC Sky)
USE_LIVE_DATA_FOR_PAPER=true

# ============================================
# Other Configuration
# ============================================
# Flask secret key (for sessions)
FLASK_SECRET_KEY=your_secret_key_here

# Database URL (optional, defaults to SQLite)
# DATABASE_URL=sqlite:///aurum_harmony.db
